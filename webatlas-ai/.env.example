# WebAtlas AI environment. Copy to .env.local and fill in. Never commit real keys.

# Optional web search (Tavily). Without it, search returns a clear "not configured" state.
TAVILY_API_KEY=

# Optional AI provider (OpenAI-compatible). Without it, AI assistant is disabled with a notice.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini